# Choose provider: groq (recommended) or gemini
LLM_PROVIDER=groq

# Groq: https://console.groq.com/keys  (free, no credit card)
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey  (free tier, no credit card)
GEMINI_API_KEY=

# Optional: override the default model
# Groq examples: openai/gpt-oss-120b, llama-3.3-70b-versatile
# Gemini examples: gemini-2.5-flash, gemini-2.5-flash-lite
LLM_MODEL=
